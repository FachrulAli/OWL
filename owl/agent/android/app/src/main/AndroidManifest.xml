<?xml version="1.0" encoding="utf-8"?>
<!--
  OWL Agent — izin yang diminta, dan ALASANNYA.

  Setiap izin di bawah ini dipakai untuk SATU sinyal yang spesifik. Tidak ada
  izin yang diminta "untuk nanti". Agent ini tidak pernah membaca isi pesan,
  isi berkas, daftar kontak, atau lokasi presisi, dan tidak meminta izin yang
  memungkinkannya.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- mengirim laporan postur ke OWL Core di dalam jaringan satuan -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- layanan latar depan: penilaian harus berjalan juga saat layar mati,
         karena sinyal unggahan-saat-idle justru muncul di situ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- sinyal 6: metadata volume keluar dan rasio layar menyala.
         Izin khusus, harus diaktifkan manual di Setelan (Akses penggunaan). -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions"/>

    <!-- sinyal 1 dan 4: daftar aplikasi, izin yang dipegangnya, dan sumber
         pemasangannya. Tanpa ini sideload tidak dapat dilihat sama sekali. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission"/>

    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <service
            android:name=".PostureService"
            android:exported="false"
            android:foregroundServiceType="dataSync"/>

        <receiver android:name=".BootWatcher" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
