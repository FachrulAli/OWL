<?xml version="1.0" encoding="utf-8"?>
<!--
  TRINETRA MTD Agent — izin yang diminta, dan ALASANNYA.

  Setiap izin di bawah ini dipakai untuk SATU sinyal deteksi yang spesifik.
  Tidak ada izin yang diminta "untuk nanti". Agent ini tidak pernah membaca
  isi pesan, isi berkas, daftar kontak, atau lokasi presisi.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- mengirim batch telemetri ke backend -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- layanan latar depan: agent harus tetap hidup saat layar mati,
         karena justru di situlah zero-click bekerja -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- trafik keluar per-aplikasi + aplikasi yang sedang di depan.
         Izin khusus: harus diaktifkan manual di Setelan (Akses penggunaan). -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions"/>

    <!-- SMS: hanya METADATA (pengirim di-hash, panjang, biner/teks).
         Isi pesan TIDAK pernah dibaca, dikirim, atau disimpan. Dipakai untuk
         mendeteksi SMS biner / WAP-push yang tidak memunculkan notifikasi —
         pola pengiriman zero-click lewat jalur operator. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS"/>
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH"/>

    <!-- status radio seluler: deteksi penurunan paksa ke 2G (IMSI catcher).
         READ_PHONE_STATE tidak memberi nomor telepon pada Android modern. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE"/>

    <!-- mendeteksi aplikasi baru terpasang + sumber pemasangnya (sideload) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission"/>

    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <service
            android:name=".TelemetryService"
            android:exported="false"
            android:foregroundServiceType="dataSync"/>

        <!-- Mendengarkan notifikasi untuk MENGETAHUI bahwa sebuah pesan
             MEMUNCULKAN notifikasi. Yang dikirim hanya: nama paket aplikasi
             dan hash pengirim. Judul dan isi notifikasi tidak dikirim. -->
        <service
            android:name=".NotificationWatcher"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>

        <receiver android:name=".SmsWatcher" android:exported="true">
            <intent-filter android:priority="0">
                <action android:name="android.provider.Telephony.SMS_RECEIVED"/>
            </intent-filter>
            <intent-filter android:priority="0">
                <action android:name="android.provider.Telephony.WAP_PUSH_RECEIVED"/>
                <data android:mimeType="application/vnd.wap.mms-message"/>
            </intent-filter>
        </receiver>

        <receiver android:name=".PackageWatcher" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED"/>
                <action android:name="android.intent.action.PACKAGE_REPLACED"/>
                <data android:scheme="package"/>
            </intent-filter>
        </receiver>

        <receiver android:name=".BootWatcher" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
